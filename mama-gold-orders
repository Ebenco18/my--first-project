<!-- Just add this stats bar inside your current mama-gold-orders.html after <header> -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:10px">
<div style="background:white;padding:10px;border-radius:10px;text-align:center"><div style="font-size:12px">Today Sales</div><div style="font-weight:bold;color:green" id="todaySales">₦0</div></div>
<div style="background:white;padding:10px;border-radius:10px;text-align:center"><div style="font-size:12px">Pending</div><div style="font-weight:bold;color:orange" id="pendingCount">0</div></div>
<div style="background:white;padding:10px;border-radius:10px;text-align:center"><div style="font-size:12px">Avg Rating</div><div style="font-weight:bold;color:gold" id="avgRate">⭐ 0</div></div>
</div>
<script>
// add inside your check() function after fetching data:
let todayStr=new Date().toDateString();
let todayOrders=data.filter(o=> new Date(o.time).toDateString()==todayStr);
let sales=todayOrders.reduce((s,o)=>s+Number(o.total||0),0);
document.getElementById('todaySales').innerText="₦"+sales;
document.getElementById('pendingCount').innerText=data.filter(o=>o.status=="pending").length;
let rated=data.filter(o=>o.rating); let avg=rated.length? (rated.reduce((s,o)=>s+Number(o.rating),0)/rated.length).toFixed(1):0;
document.getElementById('avgRate').innerText="⭐ "+avg+" ("+rated.length+")";
</script>
